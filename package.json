{
  "name": "nodecg-race-layouts",
  "version": "0.1.0",
  "private": true,
  "description": "NodeCG layouts for RTA race events",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "npm run build:extension && npm run build:dashboard && npm run build:graphics",
    "build:extension": "tsc -p tsconfig.build.json",
    "build:dashboard": "vite build --config vite.dashboard.config.ts",
    "build:graphics": "vite build --config vite.graphics.config.ts",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.dashboard.json --noEmit",
    "lint": "oxlint src test scripts ui",
    "format:check": "prettier --check \"**/*.{ts,mts,mjs,json,md,tsx,css,html}\"",
    "format": "prettier --write \"**/*.{ts,mts,mjs,json,md,tsx,css,html}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "schema:generate": "tsx scripts/generate-schemas.ts",
    "schema:check": "tsx scripts/generate-schemas.ts --check",
    "verify": "npm run typecheck && npm run lint && npm run schema:check && npm run test"
  },
  "nodecg": {
    "compatibleRange": "^2.0.0",
    "dashboardPanels": [
      {
        "name": "race-control",
        "title": "Race Control",
        "file": "race-control.html",
        "fullbleed": true
      }
    ],
    "graphics": [
      {
        "file": "race.html",
        "width": 1920,
        "height": 1080
      },
      {
        "file": "participants.html",
        "width": 1920,
        "height": 1080
      },
      {
        "file": "leaderboard.html",
        "width": 1920,
        "height": 1080
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.17.1",
    "oxlint": "^1.83.0",
    "prettier": "^3.9.8",
    "rimraf": "^6.1.3",
    "ts-json-schema-generator": "^2.9.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "@googleapis/sheets": "^18.0.0",
    "google-auth-library": "^11.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
