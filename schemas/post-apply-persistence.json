{
  "$ref": "#/definitions/PostApplyPersistenceState",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "NoneAccountLink": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "const": "none",
          "type": "string"
        }
      },
      "required": [
        "state"
      ],
      "type": "object"
    },
    "PlayerId": {
      "type": "string"
    },
    "PlayerMapping": {
      "additionalProperties": false,
      "properties": {
        "manualDisplayName": {
          "type": [
            "string",
            "null"
          ]
        },
        "playerId": {
          "$ref": "#/definitions/PlayerId"
        },
        "racetime": {
          "$ref": "#/definitions/RaceTimeAccountLink"
        },
        "speedrunCom": {
          "$ref": "#/definitions/SpeedrunComAccountLink"
        },
        "twitch": {
          "$ref": "#/definitions/TwitchAccountLink"
        }
      },
      "required": [
        "playerId",
        "manualDisplayName",
        "racetime",
        "speedrunCom",
        "twitch"
      ],
      "type": "object"
    },
    "PostApplyPersistenceItem": {
      "additionalProperties": false,
      "properties": {
        "activeRevision": {
          "type": "number"
        },
        "appliedAt": {
          "type": "string"
        },
        "attempts": {
          "type": "number"
        },
        "lastError": {
          "type": [
            "string",
            "null"
          ]
        },
        "players": {
          "items": {
            "$ref": "#/definitions/PlayerMapping"
          },
          "type": "array"
        },
        "raceHistory": {
          "$ref": "#/definitions/RaceHistoryPayload"
        }
      },
      "required": [
        "activeRevision",
        "appliedAt",
        "players",
        "raceHistory",
        "attempts",
        "lastError"
      ],
      "type": "object"
    },
    "PostApplyPersistenceState": {
      "additionalProperties": false,
      "properties": {
        "lastSavedActiveRevision": {
          "type": [
            "number",
            "null"
          ]
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "queue": {
          "items": {
            "$ref": "#/definitions/PostApplyPersistenceItem"
          },
          "type": "array"
        },
        "state": {
          "enum": [
            "idle",
            "pending",
            "saving",
            "error"
          ],
          "type": "string"
        }
      },
      "required": [
        "state",
        "queue",
        "lastSavedActiveRevision",
        "message"
      ],
      "type": "object"
    },
    "RaceHistoryPayload": {
      "additionalProperties": false,
      "properties": {
        "categoryName": {
          "type": "string"
        },
        "categorySlug": {
          "type": "string"
        },
        "commentatorPlayerIds": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "type": "array",
          "uniqueItems": true
        },
        "goal": {
          "type": "string"
        },
        "participants": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "raceId": {
          "type": "string"
        },
        "raceScreenSlots": {
          "additionalProperties": false,
          "properties": {
            "1": {
              "$ref": "#/definitions/RaceTimeUserId"
            },
            "2": {
              "$ref": "#/definitions/RaceTimeUserId"
            },
            "3": {
              "$ref": "#/definitions/RaceTimeUserId"
            },
            "4": {
              "$ref": "#/definitions/RaceTimeUserId"
            }
          },
          "required": [
            "1",
            "2",
            "3",
            "4"
          ],
          "type": "object"
        },
        "racetimeUrl": {
          "type": "string"
        }
      },
      "required": [
        "racetimeUrl",
        "raceId",
        "categorySlug",
        "categoryName",
        "goal",
        "participants",
        "raceScreenSlots",
        "commentatorPlayerIds"
      ],
      "type": "object"
    },
    "RaceTimeAccountLink": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "linked",
              "type": "string"
            },
            "value": {
              "$ref": "#/definitions/RaceTimeIdentity"
            }
          },
          "required": [
            "state",
            "value"
          ],
          "type": "object"
        },
        {
          "$ref": "#/definitions/NoneAccountLink"
        }
      ]
    },
    "RaceTimeIdentity": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "twitchLogin": {
          "type": [
            "string",
            "null"
          ]
        },
        "userId": {
          "type": "string"
        }
      },
      "required": [
        "userId",
        "name",
        "twitchLogin"
      ],
      "type": "object"
    },
    "RaceTimeUserId": {
      "type": "string"
    },
    "SpeedrunComAccountLink": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "linked",
              "type": "string"
            },
            "value": {
              "$ref": "#/definitions/SpeedrunComIdentity"
            }
          },
          "required": [
            "state",
            "value"
          ],
          "type": "object"
        },
        {
          "$ref": "#/definitions/NoneAccountLink"
        }
      ]
    },
    "SpeedrunComIdentity": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "twitchLogin": {
          "type": [
            "string",
            "null"
          ]
        },
        "userId": {
          "type": "string"
        }
      },
      "required": [
        "userId",
        "name",
        "twitchLogin"
      ],
      "type": "object"
    },
    "TwitchAccountLink": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "linked",
              "type": "string"
            },
            "value": {
              "$ref": "#/definitions/TwitchIdentity"
            }
          },
          "required": [
            "state",
            "value"
          ],
          "type": "object"
        },
        {
          "$ref": "#/definitions/NoneAccountLink"
        }
      ]
    },
    "TwitchIdentity": {
      "additionalProperties": false,
      "properties": {
        "login": {
          "type": "string"
        },
        "userId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "userId",
        "login"
      ],
      "type": "object"
    }
  },
  "title": "post-apply-persistence"
}
