{
  "$ref": "#/definitions/PostApplyPersistenceState",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "PostApplyPersistenceItem": {
      "additionalProperties": false,
      "properties": {
        "activeRevision": {
          "type": "number"
        },
        "appliedAt": {
          "type": "string"
        },
        "attempts": {
          "type": "number"
        },
        "lastError": {
          "type": [
            "string",
            "null"
          ]
        },
        "raceHistory": {
          "$ref": "#/definitions/RaceHistoryPayload"
        }
      },
      "required": [
        "activeRevision",
        "appliedAt",
        "raceHistory",
        "attempts",
        "lastError"
      ],
      "type": "object"
    },
    "PostApplyPersistenceState": {
      "additionalProperties": false,
      "properties": {
        "lastSavedActiveRevision": {
          "type": [
            "number",
            "null"
          ]
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "queue": {
          "items": {
            "$ref": "#/definitions/PostApplyPersistenceItem"
          },
          "type": "array"
        },
        "state": {
          "enum": [
            "idle",
            "pending",
            "saving",
            "error"
          ],
          "type": "string"
        }
      },
      "required": [
        "state",
        "queue",
        "lastSavedActiveRevision",
        "message"
      ],
      "type": "object"
    },
    "RaceHistoryPayload": {
      "additionalProperties": false,
      "properties": {
        "categoryName": {
          "type": "string"
        },
        "categorySlug": {
          "type": "string"
        },
        "commentatorPlayerIds": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "type": "array",
          "uniqueItems": true
        },
        "goal": {
          "type": "string"
        },
        "participants": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "raceId": {
          "type": "string"
        },
        "raceScreenSlots": {
          "additionalProperties": false,
          "properties": {
            "1": {
              "anyOf": [
                {
                  "$ref": "#/definitions/RaceTimeUserId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "2": {
              "anyOf": [
                {
                  "$ref": "#/definitions/RaceTimeUserId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "3": {
              "anyOf": [
                {
                  "$ref": "#/definitions/RaceTimeUserId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "4": {
              "anyOf": [
                {
                  "$ref": "#/definitions/RaceTimeUserId"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "1",
            "2",
            "3",
            "4"
          ],
          "type": "object"
        },
        "racetimeUrl": {
          "type": "string"
        }
      },
      "required": [
        "racetimeUrl",
        "raceId",
        "categorySlug",
        "categoryName",
        "goal",
        "participants",
        "raceScreenSlots",
        "commentatorPlayerIds"
      ],
      "type": "object"
    },
    "RaceTimeUserId": {
      "type": "string"
    }
  },
  "title": "post-apply-persistence"
}
