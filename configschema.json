{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "nodecg-race-layouts bundle config",
  "type": "object",
  "properties": {
    "event": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "shortName": { "type": ["string", "null"] },
        "logoUrl": { "type": ["string", "null"] }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "spreadsheet": {
      "type": "object",
      "description": "Google Spreadsheet that stores the Players, CategoryMappings and CategoryPresentation sheets.",
      "properties": {
        "spreadsheetId": {
          "type": "string",
          "minLength": 1,
          "description": "The id of the spreadsheet (from its URL)."
        },
        "playersSheet": {
          "type": "string",
          "minLength": 1,
          "default": "Players",
          "description": "Name of the sheet that holds the player mappings."
        },
        "categoryMappingsSheet": {
          "type": "string",
          "minLength": 1,
          "default": "CategoryMappings",
          "description": "Name of the sheet that holds the RaceTime.gg -> Speedrun.com category mappings."
        },
        "categoryPresentationSheet": {
          "type": "string",
          "minLength": 1,
          "default": "CategoryPresentation",
          "description": "Name of the sheet that holds the category presentation content."
        },
        "raceHistorySheet": {
          "type": "string",
          "minLength": 1,
          "default": "RaceHistory"
        }
      },
      "required": ["spreadsheetId"],
      "additionalProperties": false
    }
  },
  "required": ["spreadsheet"],
  "additionalProperties": true
}
