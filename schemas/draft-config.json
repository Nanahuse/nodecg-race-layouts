{
  "$ref": "#/definitions/DraftConfig",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "CategoryPresentation": {
      "additionalProperties": false,
      "properties": {
        "leaderboardHeading": {
          "type": "string"
        },
        "ruleHeading": {
          "type": "string"
        },
        "ruleLines": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "subtitle": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "subtitle",
        "ruleHeading",
        "ruleLines",
        "leaderboardHeading"
      ],
      "type": "object"
    },
    "CategorySelectionSource": {
      "enum": [
        "saved_mapping",
        "manual"
      ],
      "type": "string"
    },
    "CategorySelectionState": {
      "additionalProperties": false,
      "properties": {
        "savedMappingState": {
          "enum": [
            "none",
            "matches",
            "overridden"
          ],
          "type": "string"
        },
        "selection": {
          "anyOf": [
            {
              "$ref": "#/definitions/SpeedrunCategorySelection"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/definitions/CategorySelectionSource"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "selection",
        "source",
        "savedMappingState"
      ],
      "type": "object"
    },
    "DraftConfig": {
      "additionalProperties": false,
      "properties": {
        "categoryPresentation": {
          "anyOf": [
            {
              "$ref": "#/definitions/CategoryPresentation"
            },
            {
              "type": "null"
            }
          ]
        },
        "categorySelection": {
          "$ref": "#/definitions/CategorySelectionState"
        },
        "commentatorPlayerIds": {
          "items": {
            "$ref": "#/definitions/PlayerId"
          },
          "maxItems": 3,
          "type": "array",
          "uniqueItems": true
        },
        "commentators": {
          "additionalProperties": {
            "$ref": "#/definitions/PlayerSnapshot"
          },
          "maxItems": 3,
          "type": "object",
          "uniqueItems": true
        },
        "participants": {
          "items": {
            "$ref": "#/definitions/DraftRaceParticipant"
          },
          "type": "array"
        },
        "persons": {
          "additionalProperties": {
            "$ref": "#/definitions/DraftPerson"
          },
          "type": "object"
        },
        "race": {
          "anyOf": [
            {
              "$ref": "#/definitions/RaceReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "raceScreenSlots": {
          "$ref": "#/definitions/DraftRaceScreenSlots"
        },
        "revision": {
          "type": "number"
        }
      },
      "required": [
        "revision",
        "race",
        "participants",
        "persons",
        "raceScreenSlots",
        "commentatorPlayerIds",
        "commentators",
        "categorySelection",
        "categoryPresentation"
      ],
      "type": "object"
    },
    "DraftPerson": {
      "additionalProperties": false,
      "properties": {
        "identity": {
          "additionalProperties": false,
          "properties": {
            "racetimeUserId": {
              "type": [
                "string",
                "null"
              ]
            },
            "speedrunComUserId": {
              "type": [
                "string",
                "null"
              ]
            },
            "twitchLogin": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "racetimeUserId",
            "twitchLogin",
            "speedrunComUserId"
          ],
          "type": "object"
        },
        "player": {
          "anyOf": [
            {
              "$ref": "#/definitions/PlayerSnapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "playerId": {
          "type": [
            "string",
            "null"
          ]
        },
        "ref": {
          "$ref": "#/definitions/DraftPersonRef"
        },
        "resolution": {
          "$ref": "#/definitions/DraftPersonResolution"
        }
      },
      "required": [
        "ref",
        "playerId",
        "identity",
        "player",
        "resolution"
      ],
      "type": "object"
    },
    "DraftPersonRef": {
      "type": "string"
    },
    "DraftPersonResolution": {
      "enum": [
        "matched",
        "unresolved",
        "ambiguous",
        "conflict"
      ],
      "type": "string"
    },
    "DraftRaceParticipant": {
      "additionalProperties": false,
      "properties": {
        "personRef": {
          "type": "string"
        },
        "racetimeUserId": {
          "$ref": "#/definitions/RaceTimeUserId"
        }
      },
      "required": [
        "racetimeUserId",
        "personRef"
      ],
      "type": "object"
    },
    "DraftRaceScreenSlots": {
      "additionalProperties": false,
      "properties": {
        "1": {
          "anyOf": [
            {
              "$ref": "#/definitions/RaceTimeUserId"
            },
            {
              "type": "null"
            }
          ]
        },
        "2": {
          "anyOf": [
            {
              "$ref": "#/definitions/RaceTimeUserId"
            },
            {
              "type": "null"
            }
          ]
        },
        "3": {
          "anyOf": [
            {
              "$ref": "#/definitions/RaceTimeUserId"
            },
            {
              "type": "null"
            }
          ]
        },
        "4": {
          "anyOf": [
            {
              "$ref": "#/definitions/RaceTimeUserId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "1",
        "2",
        "3",
        "4"
      ],
      "type": "object"
    },
    "PlayerId": {
      "type": "string"
    },
    "PlayerSnapshot": {
      "additionalProperties": false,
      "properties": {
        "displayName": {
          "type": "string"
        },
        "playerId": {
          "type": "string"
        },
        "racetime": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "userId": {
                  "type": "string"
                }
              },
              "required": [
                "userId",
                "name"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "speedrunCom": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "userId": {
                  "type": "string"
                }
              },
              "required": [
                "userId",
                "name"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "twitch": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "displayName": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "login": {
                  "type": "string"
                },
                "userId": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "userId",
                "login",
                "displayName"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "youtube": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "playerId",
        "displayName",
        "racetime",
        "speedrunCom",
        "twitch",
        "youtube"
      ],
      "type": "object"
    },
    "RaceReference": {
      "additionalProperties": false,
      "properties": {
        "canonicalUrl": {
          "type": "string"
        },
        "categoryName": {
          "type": "string"
        },
        "categorySlug": {
          "type": "string"
        },
        "goal": {
          "type": "string"
        },
        "raceId": {
          "type": "string"
        }
      },
      "required": [
        "canonicalUrl",
        "raceId",
        "categorySlug",
        "categoryName",
        "goal"
      ],
      "type": "object"
    },
    "RaceTimeUserId": {
      "type": "string"
    },
    "SpeedrunCategorySelection": {
      "additionalProperties": false,
      "properties": {
        "categoryId": {
          "type": "string"
        },
        "categoryName": {
          "type": "string"
        },
        "emulator": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "gameId": {
          "type": "string"
        },
        "gameName": {
          "type": "string"
        },
        "levelId": {
          "type": [
            "string",
            "null"
          ]
        },
        "platformId": {
          "type": [
            "string",
            "null"
          ]
        },
        "regionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "timingMethod": {
          "anyOf": [
            {
              "$ref": "#/definitions/TimingMethod"
            },
            {
              "type": "null"
            }
          ]
        },
        "variables": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "required": [
        "gameId",
        "gameName",
        "categoryId",
        "categoryName",
        "levelId",
        "variables",
        "platformId",
        "regionId",
        "emulator",
        "timingMethod"
      ],
      "type": "object"
    },
    "TimingMethod": {
      "enum": [
        "realtime",
        "realtime_noloads",
        "ingame"
      ],
      "type": "string"
    }
  },
  "title": "draft-config"
}
