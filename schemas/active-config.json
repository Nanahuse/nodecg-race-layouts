{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "anyOf": [
    {
      "$ref": "#/definitions/ActiveConfig"
    },
    {
      "type": "null"
    }
  ],
  "definitions": {
    "ActiveConfig": {
      "additionalProperties": false,
      "properties": {
        "categoryPresentation": {
          "anyOf": [
            {
              "$ref": "#/definitions/CategoryPresentation"
            },
            {
              "type": "null"
            }
          ]
        },
        "categorySelection": {
          "$ref": "#/definitions/SpeedrunCategorySelection"
        },
        "commentatorPlayerIds": {
          "items": {
            "$ref": "#/definitions/PlayerId"
          },
          "maxItems": 3,
          "type": "array",
          "uniqueItems": true
        },
        "participants": {
          "items": {
            "$ref": "#/definitions/ActiveRaceParticipant"
          },
          "type": "array"
        },
        "players": {
          "additionalProperties": {
            "$ref": "#/definitions/PlayerSnapshot"
          },
          "type": "object"
        },
        "race": {
          "$ref": "#/definitions/RaceReference"
        },
        "raceScreenSlots": {
          "$ref": "#/definitions/ActiveRaceScreenSlots"
        },
        "revision": {
          "type": "number"
        }
      },
      "required": [
        "revision",
        "race",
        "participants",
        "players",
        "raceScreenSlots",
        "commentatorPlayerIds",
        "categorySelection",
        "categoryPresentation"
      ],
      "type": "object"
    },
    "ActiveRaceParticipant": {
      "additionalProperties": false,
      "properties": {
        "playerId": {
          "$ref": "#/definitions/PlayerId"
        },
        "racetimeUserId": {
          "$ref": "#/definitions/RaceTimeUserId"
        }
      },
      "required": [
        "racetimeUserId",
        "playerId"
      ],
      "type": "object"
    },
    "ActiveRaceScreenSlots": {
      "additionalProperties": false,
      "properties": {
        "1": {
          "anyOf": [
            {
              "$ref": "#/definitions/RaceTimeUserId"
            },
            {
              "type": "null"
            }
          ]
        },
        "2": {
          "anyOf": [
            {
              "$ref": "#/definitions/RaceTimeUserId"
            },
            {
              "type": "null"
            }
          ]
        },
        "3": {
          "anyOf": [
            {
              "$ref": "#/definitions/RaceTimeUserId"
            },
            {
              "type": "null"
            }
          ]
        },
        "4": {
          "anyOf": [
            {
              "$ref": "#/definitions/RaceTimeUserId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "1",
        "2",
        "3",
        "4"
      ],
      "type": "object"
    },
    "CategoryPresentation": {
      "additionalProperties": false,
      "properties": {
        "leaderboardHeading": {
          "type": "string"
        },
        "ruleHeading": {
          "type": "string"
        },
        "ruleLines": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "subtitle": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "subtitle",
        "ruleHeading",
        "ruleLines",
        "leaderboardHeading"
      ],
      "type": "object"
    },
    "PlayerId": {
      "type": "string"
    },
    "PlayerSnapshot": {
      "additionalProperties": false,
      "properties": {
        "displayName": {
          "type": "string"
        },
        "playerId": {
          "type": "string"
        },
        "racetime": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "userId": {
                  "type": "string"
                }
              },
              "required": [
                "userId",
                "name"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "speedrunCom": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "userId": {
                  "type": "string"
                }
              },
              "required": [
                "userId",
                "name"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "twitch": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "displayName": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "login": {
                  "type": "string"
                },
                "userId": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "userId",
                "login",
                "displayName"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "youtube": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "playerId",
        "displayName",
        "racetime",
        "speedrunCom",
        "twitch",
        "youtube"
      ],
      "type": "object"
    },
    "RaceReference": {
      "additionalProperties": false,
      "properties": {
        "canonicalUrl": {
          "type": "string"
        },
        "categoryName": {
          "type": "string"
        },
        "categorySlug": {
          "type": "string"
        },
        "goal": {
          "type": "string"
        },
        "raceId": {
          "type": "string"
        }
      },
      "required": [
        "canonicalUrl",
        "raceId",
        "categorySlug",
        "categoryName",
        "goal"
      ],
      "type": "object"
    },
    "RaceTimeUserId": {
      "type": "string"
    },
    "SpeedrunCategorySelection": {
      "additionalProperties": false,
      "properties": {
        "categoryId": {
          "type": "string"
        },
        "categoryName": {
          "type": "string"
        },
        "emulator": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "gameId": {
          "type": "string"
        },
        "gameName": {
          "type": "string"
        },
        "levelId": {
          "type": [
            "string",
            "null"
          ]
        },
        "platformId": {
          "type": [
            "string",
            "null"
          ]
        },
        "regionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "timingMethod": {
          "anyOf": [
            {
              "$ref": "#/definitions/TimingMethod"
            },
            {
              "type": "null"
            }
          ]
        },
        "variables": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "required": [
        "gameId",
        "gameName",
        "categoryId",
        "categoryName",
        "levelId",
        "variables",
        "platformId",
        "regionId",
        "emulator",
        "timingMethod"
      ],
      "type": "object"
    },
    "TimingMethod": {
      "enum": [
        "realtime",
        "realtime_noloads",
        "ingame"
      ],
      "type": "string"
    }
  },
  "title": "active-config"
}
